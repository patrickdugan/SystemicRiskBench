{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:systemic-risk-bench:run-manifest:0.1.0",
  "title": "Systemic Risk Bench experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_label", "repo_commit", "checkpoint_digest", "tokenizer", "parameter_count", "precision", "device", "decoding", "budget", "internal_computation", "case_set_digest", "split", "evaluator_digest", "measured", "unknown_fields"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_label": {"type": "string", "minLength": 1},
    "repo_commit": {"type": ["string", "null"]},
    "checkpoint_digest": {"type": ["string", "null"]},
    "tokenizer": {"type": ["string", "null"]},
    "parameter_count": {"type": ["integer", "null"], "minimum": 1},
    "precision": {"type": ["string", "null"]},
    "device": {"type": ["string", "null"]},
    "decoding": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature", "top_p", "seed"],
      "properties": {
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "top_p": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_tool_calls", "memory_bytes", "wall_time_seconds", "tool_policy"],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "tool_policy": {"type": "string", "minLength": 1}
      }
    },
    "internal_computation": {
      "type": "object", "additionalProperties": false,
      "required": ["recurrence_policy", "max_steps", "measured_steps", "flops"],
      "properties": {
        "recurrence_policy": {"type": ["string", "null"]},
        "max_steps": {"type": ["integer", "null"], "minimum": 0},
        "measured_steps": {"type": ["integer", "null"], "minimum": 0},
        "flops": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "case_set_digest": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "validation", "held_out", "public_historical_diagnostic"]},
    "evaluator_digest": {"type": "string", "minLength": 1},
    "measured": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "tool_calls", "wall_time_seconds", "peak_memory_bytes", "energy_joules"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_seconds": {"type": ["number", "null"], "minimum": 0},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "energy_joules": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "unknown_fields": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
